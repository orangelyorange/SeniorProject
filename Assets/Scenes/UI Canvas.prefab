--- !u!114 &5718947492364148037
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8072984038721036135}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\"Gugurang, mighty guardian of our lands, I give thanks for the bounty
    of our harvest. May these golden grains bring life to our families and our village.
    Watch over the terraces and rivers that nourish them. Protect us from the pests
    that nibble our hopes and from the storms that threaten our joy. Guide the hands
    that work the fields and the spirits that watch over us. May those who walk among
    the rice feel the rhythm of life, and may their steps be light like the wind
    that dances across our plains.\u201D"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: a68f8275e86abf649b9ef74c4e77d0e4, type: 2}
  m_sharedMaterial: {fileID: 7135482080705561172, guid: a68f8275e86abf649b9ef74c4e77d0e4, type: 2}
